
Author: Piyusha Sharma
Project: Smart Soil Health Monitor

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#f5f8f3">
    <title>Smart Soil Health Monitor</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
       

        :root {
            --green-950: #173b2b;
            --green-800: #205c3b;
            --green-700: #287348;
            --green-100: #e5f3e8;
            --green-50: #f0f7f0;
            --page: #f5f8f3;
            --white: #ffffff;
            --text: #1e3026;
            --muted: #738076;
            --border: #e5ebe3;
            --orange: #bd7424;
            --blue: #3478b8;
            --red: #b42318;
            --shadow: 0 5px 20px rgba(29, 58, 39, 0.045);
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            background: var(--page);
            color: var(--text);
            font-family: 'Inter', sans-serif;
            font-size: 14px;
            line-height: 1.6;
        }

        button, input {
            font: inherit;
        }

        button, a {
            -webkit-tap-highlight-color: transparent;
        }

        a {
            color: var(--green-700);
            text-decoration: none;
        }

        a:hover {
            text-decoration: underline;
        }

        .app-shell {
            max-width: 1440px;
            margin: auto;
            padding: 28px;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 26px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .brand-icon {
            width: 48px;
            height: 48px;
            display: grid;
            place-items: center;
            background: var(--green-800);
            color: white;
            border-radius: 15px;
            font-size: 25px;
        }

        .brand h1 {
            margin: 0;
            font-size: 20px;
            letter-spacing: -0.7px;
            line-height: 1.35;
        }

        .brand p {
            margin: 3px 0 0;
            color: var(--muted);
            font-size: 12px;
        }

        .location-chip, .pill {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 8px 12px;
            border: 1px solid var(--border);
            border-radius: 999px;
            background: white;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
        }

        .hero {
            position: relative;
            overflow: hidden;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 24px;
            padding: 32px;
            margin-bottom: 25px;
            color: white;
            background: linear-gradient(120deg, #173b2b 0%, #246541 65%, #378052 100%);
            border-radius: 22px;
            box-shadow: var(--shadow);
        }

        .hero::after {
            content: "🌿";
            position: absolute;
            right: 30%;
            top: -48px;
            font-size: 170px;
            opacity: 0.07;
            pointer-events: none;
        }

        .eyebrow {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1.7px;
            font-weight: 700;
            opacity: 0.8;
        }

        .hero h2 {
            margin: 8px 0 10px;
            font-size: clamp(24px, 3vw, 34px);
            letter-spacing: -1.1px;
            line-height: 1.25;
        }

        .hero p {
            max-width: 620px;
            margin: 0;
            color: #e1eee3;
            line-height: 1.8;
        }

        .hero-meta {
            position: relative;
            z-index: 1;
            min-width: 180px;
            padding: 17px;
            border: 1px solid #ffffff30;
            border-radius: 15px;
            background: #ffffff12;
        }

        .hero-meta small {
            display: block;
            color: #d9e8dc;
            margin-bottom: 5px;
        }

        .hero-meta strong {
            font-size: 14px;
        }

        .section-heading {
            display: flex;
            justify-content: space-between;
            align-items: end;
            gap: 15px;
            flex-wrap: wrap;
            margin: 30px 0 15px;
        }

        .section-heading h2 {
            margin: 0;
            font-size: 19px;
            letter-spacing: -0.5px;
        }

        .section-heading p {
            margin: 4px 0 0;
            color: var(--muted);
            font-size: 12px;
        }

        .panel, .metric-card {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 16px;
            box-shadow: var(--shadow);
        }

        .status-panel {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            flex-wrap: wrap;
            padding: 17px 20px;
        }

        .status-left {
            display: flex;
            gap: 13px;
            align-items: center;
        }

        .status-dot {
            width: 10px;
            height: 10px;
            flex-shrink: 0;
            background: #a0aaa1;
            border-radius: 50%;
        }

        .status-dot.online {
            background: #249653;
            box-shadow: 0 0 0 4px #24965318;
        }

        .status-dot.offline {
            background: #d92d20;
        }

        .status-title {
            font-weight: 700;
            font-size: 13px;
        }

        .small-text {
            color: var(--muted);
            font-size: 11px;
        }

        .status-details {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            margin-top: 6px;
        }

        .status-details span {
            color: var(--muted);
            font-size: 11px;
        }

        .status-details strong {
            color: var(--text);
            font-weight: 600;
        }

        .button {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            min-height: 40px;
            padding: 10px 15px;
            color: white;
            background: var(--green-800);
            border: 1px solid var(--green-800);
            border-radius: 10px;
            cursor: pointer;
            font-size: 12px;
            font-weight: 700;
            transition: background 0.2s, transform 0.2s;
        }

        .button:hover {
            background: var(--green-950);
            transform: translateY(-1px);
        }

        .button:disabled {
            opacity: 0.6;
            cursor: wait;
            transform: none;
        }

        .button.secondary {
            color: var(--green-800);
            background: white;
            border-color: #dce7dc;
        }

        .button.secondary:hover {
            background: var(--green-50);
        }

        .button-row {
            display: flex;
            gap: 9px;
            flex-wrap: wrap;
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 16px;
        }

        .metric-card {
            min-width: 0;
            padding: 20px;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .metric-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 9px 26px #1d3a2710;
        }

        .metric-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
        }

        .metric-label {
            color: #657368;
            font-size: 12px;
            font-weight: 600;
        }

        .metric-icon {
            display: grid;
            place-items: center;
            width: 38px;
            height: 38px;
            flex-shrink: 0;
            border-radius: 12px;
            background: var(--green-50);
            font-size: 19px;
        }

        .metric-icon.orange {
            background: #fff2df;
        }

        .metric-icon.blue {
            background: #eaf3ff;
        }

        .metric-value {
            margin: 18px 0 5px;
            font-size: clamp(27px, 3vw, 34px);
            line-height: 1.2;
            letter-spacing: -1.2px;
            font-weight: 800;
            overflow-wrap: anywhere;
        }

        .metric-unit {
            color: var(--muted);
            font-size: 11px;
        }

        .metric-foot {
            margin-top: 17px;
            padding-top: 12px;
            border-top: 1px solid #edf0eb;
            color: var(--muted);
            font-size: 11px;
        }

        .weather-banner {
            display: flex;
            align-items: start;
            gap: 11px;
            margin-bottom: 15px;
            padding: 14px 16px;
            background: #f0f6ff;
            border: 1px solid #dfeaff;
            border-radius: 12px;
            color: #355b82;
            font-size: 12px;
            line-height: 1.7;
        }

        .weather-banner strong {
            display: block;
            margin-bottom: 2px;
        }

        .panel {
            padding: 20px;
            margin-bottom: 17px;
        }

        .panel-heading {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
            margin-bottom: 17px;
        }

        .panel-heading h3 {
            margin: 0;
            font-size: 15px;
        }

        .panel-heading p {
            margin: 4px 0 0;
            color: var(--muted);
            font-size: 11px;
        }

        .table-wrap {
            width: 100%;
            overflow-x: auto;
            border: 1px solid var(--border);
            border-radius: 12px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 760px;
        }

        th, td {
            padding: 13px 15px;
            border-bottom: 1px solid #edf0eb;
            text-align: left;
            white-space: nowrap;
            font-size: 11px;
        }

        th {
            color: #637268;
            background: #f7f9f6;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        tbody tr:hover td {
            background: #fafcf9;
        }

        .empty-cell {
            padding: 25px;
            color: var(--muted);
            text-align: center;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 16px;
        }

        .form-field {
            min-width: 0;
        }

        .form-field label {
            display: block;
            margin-bottom: 7px;
            font-size: 12px;
            font-weight: 700;
        }

        .form-field input {
            width: 100%;
            min-height: 43px;
            padding: 10px 12px;
            color: var(--text);
            background: #fff;
            border: 1px solid #dce4dc;
            border-radius: 9px;
            outline: none;
        }

        .form-field input:focus {
            border-color: var(--green-700);
            box-shadow: 0 0 0 3px #28734817;
        }

        .form-note {
            margin: 0 0 18px;
            padding: 12px 14px;
            background: #fff8e9;
            border: 1px solid #f5e7c8;
            border-radius: 10px;
            color: #79551e;
            font-size: 12px;
        }

        .form-actions {
            display: flex;
            gap: 12px;
            align-items: center;
            flex-wrap: wrap;
            margin-top: 18px;
        }

        .message {
            margin: 10px 0 0;
            font-size: 12px;
        }

        .success {
            color: #187345;
        }

        .error {
            color: var(--red);
        }

        .muted {
            color: var(--muted);
        }

        .about-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .about-item {
            padding: 17px;
            border-radius: 12px;
            background: #f7f9f6;
        }

        .about-item strong {
            display: block;
            margin-bottom: 5px;
            font-size: 12px;
        }

        .about-item p {
            margin: 0;
            color: var(--muted);
            font-size: 12px;
            line-height: 1.8;
        }

        footer {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            padding: 25px 0 5px;
            color: var(--muted);
            font-size: 11px;
        }

        @media (min-width: 1100px) {
            .cards {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }
        }

        @media (max-width: 760px) {
            .app-shell {
                padding: 16px;
            }

            .topbar {
                align-items: start;
            }

            .location-chip {
                display: none;
            }

            .hero {
                padding: 24px;
                flex-direction: column;
                align-items: stretch;
            }

            .hero-meta {
                min-width: 0;
            }

            .cards {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 11px;
            }

            .metric-card {
                padding: 15px;
            }

            .form-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .status-panel {
                align-items: flex-start;
            }

            .status-details {
                gap: 8px 15px;
            }
        }

        @media (max-width: 460px) {
            .app-shell {
                padding: 12px;
            }

            .brand h1 {
                font-size: 16px;
            }

            .brand-icon {
                width: 42px;
                height: 42px;
            }

            .cards, .form-grid, .about-grid {
                grid-template-columns: 1fr;
            }

            .hero h2 {
                font-size: 25px;
            }

            .panel {
                padding: 14px;
            }

            .button-row, .button-row .button {
                width: 100%;
            }

            .status-panel {
                padding: 15px;
            }
        }
    </style>
</head>

<body>
<div class="app-shell">

    <nav class="topbar">
        <div class="brand">
            <div class="brand-icon" aria-hidden="true">🌱</div>
            <div>
                <h1>Smart Soil Health</h1>
                <p>Soil intelligence dashboard</p>
            </div>
        </div>
        <div class="location-chip">📍 Amritsar, Punjab, India</div>
    </nav>

    <header class="hero">
        <div>
            <div class="eyebrow">Agricultural monitoring · Project prototype</div>
            <h2>Understand your soil.<br>Monitor every change.</h2>
            <p>
                A monitoring dashboard for soil and environmental parameters,
                developed as part of an IoT-based agricultural monitoring project
                for Punjab.
            </p>
        </div>
        <div class="hero-meta">
            <small>Dashboard status</small>
            <strong id="heroStatus">Connecting to server...</strong>
            <small style="margin-top:10px">Last refreshed</small>
            <strong id="heroRefreshTime">Not yet updated</strong>
        </div>
    </header>

    <section class="panel status-panel">
        <div>
            <div class="status-left">
                <span id="statusDot" class="status-dot"></span>
                <div>
                    <div class="status-title">
                        Backend: <span id="connection" class="muted">Connecting...</span>
                    </div>
                    <div class="small-text">
                        Latest reading: <span id="readingTime">Waiting for data</span>
                    </div>
                </div>
            </div>
            <div class="status-details">
                <span>Total records: <strong id="totalReadings">0</strong></span>
                <span>Data source: <strong id="dataSource">Not specified</strong></span>
            </div>
        </div>
        <button class="button" id="refreshButton" type="button" onclick="loadReadings()">
            ↻ Refresh readings
        </button>
    </section>

    <div class="section-heading">
        <div>
            <h2>Latest sensor readings</h2>
            <p>Latest values saved by the application</p>
        </div>
        <span class="pill">🧪 Sensor data</span>
    </div>

    <section class="cards">
        <article class="metric-card">
            <div class="metric-top">
                <span class="metric-label">Soil Moisture</span>
                <span class="metric-icon">💧</span>
            </div>
            <div class="metric-value" id="moisture">--</div>
            <div class="metric-unit">Raw ADC · 0–4095</div>
            <div class="metric-foot">Requires sensor calibration for moisture percentage</div>
        </article>

        <article class="metric-card">
            <div class="metric-top">
                <span class="metric-label">Soil pH Sensor</span>
                <span class="metric-icon orange">⚗️</span>
            </div>
            <div class="metric-value" id="ph">--</div>
            <div class="metric-unit">Raw ADC value</div>
            <div class="metric-foot">Not a calibrated pH measurement</div>
        </article>

        <article class="metric-card">
            <div class="metric-top">
                <span class="metric-label">Soil EC Sensor</span>
                <span class="metric-icon blue">〰️</span>
            </div>
            <div class="metric-value" id="ec">--</div>
            <div class="metric-unit">Raw ADC value</div>
            <div class="metric-foot">Not a calibrated electrical conductivity value</div>
        </article>

        <article class="metric-card">
            <div class="metric-top">
                <span class="metric-label">Soil Temperature</span>
                <span class="metric-icon orange">🌡️</span>
            </div>
            <div class="metric-value" id="soilTemp">--</div>
            <div class="metric-unit">°C</div>
            <div class="metric-foot">From the latest saved sensor record</div>
        </article>

        <article class="metric-card">
            <div class="metric-top">
                <span class="metric-label">Air Temperature</span>
                <span class="metric-icon orange">☀️</span>
            </div>
            <div class="metric-value" id="airTemp">--</div>
            <div class="metric-unit">°C</div>
            <div class="metric-foot">From the latest saved sensor record</div>
        </article>

        <article class="metric-card">
            <div class="metric-top">
                <span class="metric-label">Air Humidity</span>
                <span class="metric-icon blue">☁️</span>
            </div>
            <div class="metric-value" id="humidity">--</div>
            <div class="metric-unit">%</div>
            <div class="metric-foot">From the latest saved sensor record</div>
        </article>
    </section>

    <div class="section-heading">
        <div>
            <h2>Weather estimates</h2>
            <p>Environmental information for Amritsar, Punjab</p>
        </div>
        <span class="pill">🌦️ Open-Meteo</span>
    </div>

    <div class="weather-banner">
        <span aria-hidden="true">ℹ️</span>
        <div>
            <strong>Estimated weather data — not physical sensor measurements</strong>
            Air temperature and humidity are weather data. Soil temperature and
            soil moisture values provided by the weather integration are estimates
            or modelled values, not readings from your own soil sensors.
        </div>
    </div>

    <section class="panel">
        <div class="panel-heading">
            <div>
                <h3>Latest weather snapshot</h3>
                <p id="weatherMessage" role="status">Loading saved weather estimates...</p>
            </div>
            <div class="button-row">
                <button class="button" id="fetchWeatherButton" type="button" onclick="fetchWeather()">
                    ↻ Fetch latest weather
                </button>
                <a class="button secondary" href="/api/weather-readings.csv">
                    ↓ Export CSV
                </a>
            </div>
        </div>

        <div class="small-text" style="margin-bottom:14px">
            Latest weather timestamp: <strong id="weatherTime">--</strong>
        </div>

        <div class="cards">
            <article class="metric-card">
                <div class="metric-top">
                    <span class="metric-label">Air Temperature</span>
                    <span class="metric-icon orange">🌡️</span>
                </div>
                <div class="metric-value" id="weatherAirTemp">--</div>
                <div class="metric-unit">°C</div>
            </article>

            <article class="metric-card">
                <div class="metric-top">
                    <span class="metric-label">Humidity</span>
                    <span class="metric-icon blue">💧</span>
                </div>
                <div class="metric-value" id="weatherHumidity">--</div>
                <div class="metric-unit">%</div>
            </article>

            <article class="metric-card">
                <div class="metric-top">
                    <span class="metric-label">Soil Temperature</span>
                    <span class="metric-icon orange">🌱</span>
                </div>
                <div class="metric-value" id="weatherSoilTemp">--</div>
                <div class="metric-unit">°C · estimated</div>
            </article>

            <article class="metric-card">
                <div class="metric-top">
                    <span class="metric-label">Soil Moisture</span>
                    <span class="metric-icon">💦</span>
                </div>
                <div class="metric-value" id="weatherSoilMoisture">--</div>
                <div class="metric-unit">Modelled value</div>
            </article>
        </div>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <div>
                <h3>Recent weather estimates</h3>
                <p>Most recent records returned by the weather API</p>
            </div>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                <tr>
                    <th>Timestamp</th>
                    <th>Location</th>
                    <th>Air temp (°C)</th>
                    <th>Humidity (%)</th>
                    <th>Soil temp (°C)</th>
                    <th>Soil moisture</th>
                    <th>Source</th>
                </tr>
                </thead>
                <tbody id="weatherTable">
                <tr><td class="empty-cell" colspan="7">Loading weather records...</td></tr>
                </tbody>
            </table>
        </div>
    </section>

    <div class="section-heading">
        <div>
            <h2>Manual test reading</h2>
            <p>Enter a test record to check the dashboard and database workflow</p>
        </div>
        <span class="pill">📝 Software testing</span>
    </div>

    <section class="panel">
        <p class="form-note">
            ⚠️ Manually entered records are test data, not actual field measurements.
            Raw ADC inputs do not directly represent calibrated pH, EC, or moisture.
        </p>

        <form id="manualForm">
            <div class="form-grid">
                <div class="form-field">
                    <label for="inputMoisture">Soil moisture (raw ADC)</label>
                    <input id="inputMoisture" type="number" min="0" max="4095" step="1" value="1777" required>
                </div>

                <div class="form-field">
                    <label for="inputPh">Soil pH sensor (raw ADC)</label>
                    <input id="inputPh" type="number" min="0" max="4095" step="1" value="2222" required>
                </div>

                <div class="form-field">
                    <label for="inputEc">Soil EC sensor (raw ADC)</label>
                    <input id="inputEc" type="number" min="0" max="4095" step="1" value="1888" required>
                </div>

                <div class="form-field">
                    <label for="inputSoilTemp">Soil temperature (°C)</label>
                    <input id="inputSoilTemp" type="number" min="-50" max="100" step="0.1" value="26.5" required>
                </div>

                <div class="form-field">
                    <label for="inputAirTemp">Air temperature (°C)</label>
                    <input id="inputAirTemp" type="number" min="-50" max="100" step="0.1" value="29" required>
                </div>

                <div class="form-field">
                    <label for="inputHumidity">Air humidity (%)</label>
                    <input id="inputHumidity" type="number" min="0" max="100" step="0.1" value="61" required>
                </div>
            </div>

            <div class="form-actions">
                <button class="button" type="submit" id="addReadingButton">＋ Save test reading</button>
                <a class="button secondary" href="/api/readings.csv">↓ Export sensor CSV</a>
                <span class="small-text">Records are saved through your existing Flask endpoint.</span>
            </div>
            <p id="formMessage" class="message" role="status" aria-live="polite"></p>
        </form>
    </section>

    <div class="section-heading">
        <div>
            <h2>Recent sensor records</h2>
            <p>Latest saved readings from the Flask API</p>
        </div>
    </div>

    <section class="panel">
        <div class="table-wrap">
            <table>
                <thead>
                <tr>
                    <th>ID</th>
                    <th>Timestamp</th>
                    <th>Moisture raw</th>
                    <th>pH raw</th>
                    <th>EC raw</th>
                    <th>Soil temp (°C)</th>
                    <th>Air temp (°C)</th>
                    <th>Humidity (%)</th>
                </tr>
                </thead>
                <tbody id="readingsTable">
                <tr><td class="empty-cell" colspan="8">Waiting for readings...</td></tr>
                </tbody>
            </table>
        </div>
    </section>

    <div class="section-heading">
        <div>
            <h2>About this project</h2>
            <p>Purpose, data quality and current development status</p>
        </div>
    </div>

    <section class="panel">
        <div class="about-grid">
            <div class="about-item">
                <strong>🌾 Project objective</strong>
                <p>
                    Develop an IoT-based system for monitoring soil and environmental
                    parameters relevant to agricultural fields in Punjab.
                </p>
            </div>
            <div class="about-item">
                <strong>💻 Current software</strong>
                <p>
                    Flask backend, SQLite storage, manual test readings, weather
                    integration and CSV export.
                </p>
            </div>
            <div class="about-item">
                <strong>🔬 Data quality</strong>
                <p>
                    Raw ADC values are not calibrated measurements. Weather-derived
                    soil values are estimates. Validate physical sensors before using
                    results as field data.
                </p>
            </div>
            <div class="about-item">
                <strong>🚀 Next development stage</strong>
                <p>
                    Integrate the ESP32 and physical sensors, calibrate measurements,
                    and validate timestamped readings collected from agricultural
                    locations.
                </p>
            </div>
        </div>
    </section>

    <footer>
        <span>Smart Soil Health Monitor · Developed by Piyusha Sharma</span>
        <span>Python · Flask · SQLite · HTML · CSS · JavaScript</span>
    </footer>
</div>

<script>
    /*
    Author: Piyusha Sharma
    Project: Smart Soil Health Monitor
    */

    // This must match the demo key currently configured in app.py.
    // Do not publish this client-side key in a public repository.
    // We should move authentication server-side before public deployment.
    const WEATHER_API_KEY = "soil-demo-change-this-to-a-long-random-secret";

    function showValue(value, digits = 2) {
        if (value === null || value === undefined || value === "") {
            return "--";
        }

        const number = Number(value);
        if (!Number.isFinite(number)) return "--";

        return Number.isInteger(number)
            ? String(number)
            : number.toFixed(digits);
    }

    function showTimestamp(value) {
        if (!value) return "--";

        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return String(value);

        return date.toLocaleString();
    }

    function showCell(value) {
        return value === null || value === undefined || value === ""
            ? "--"
            : String(value);
    }

    function setMessage(element, message, type = "muted") {
        element.textContent = message;
        element.className = type;
    }

    function setEmptyRow(table, columns, message) {
        table.replaceChildren();

        const row = document.createElement("tr");
        const cell = document.createElement("td");

        cell.colSpan = columns;
        cell.className = "empty-cell";
        cell.textContent = message;

        row.appendChild(cell);
        table.appendChild(row);
    }

    function addTableRow(table, values) {
        const row = document.createElement("tr");

        values.forEach(value => {
            const cell = document.createElement("td");
            cell.textContent = showCell(value);
            row.appendChild(cell);
        });

        table.appendChild(row);
    }

    async function loadReadings() {
        const connection = document.getElementById("connection");
        const statusDot = document.getElementById("statusDot");
        const refreshButton = document.getElementById("refreshButton");
        const table = document.getElementById("readingsTable");

        refreshButton.disabled = true;
        connection.textContent = "Connecting...";
        connection.className = "muted";

        try {
            const response = await fetch("/api/readings", {
                cache: "no-store"
            });

            if (!response.ok) {
                throw new Error("HTTP " + response.status);
            }

            const readings = await response.json();

            if (!Array.isArray(readings)) {
                throw new Error("Unexpected API response");
            }

            connection.textContent = "Connected";
            connection.className = "success";
            statusDot.className = "status-dot online";
            document.getElementById("heroStatus").textContent = "Server connected";

            const refreshedAt = new Date().toLocaleString();
            document.getElementById("refreshTime")?.textContent;
            document.getElementById("heroRefreshTime").textContent = refreshedAt;

            document.getElementById("totalReadings").textContent = readings.length;

            if (readings.length === 0) {
                setEmptyRow(table, 8, "No sensor readings saved yet.");

                document.getElementById("readingTime").textContent = "No data available";
                document.getElementById("dataSource").textContent = "No records";

                ["moisture", "ph", "ec", "soilTemp", "airTemp", "humidity"]
                    .forEach(id => {
                        document.getElementById(id).textContent = "--";
                    });

                return;
            }

            const latest = readings[0];

            document.getElementById("moisture").textContent =
                showValue(latest.moisture_raw);

            document.getElementById("ph").textContent =
                showValue(latest.ph_raw);

            document.getElementById("ec").textContent =
                showValue(latest.ec_raw);

            document.getElementById("soilTemp").textContent =
                showValue(latest.soil_temperature);

            document.getElementById("airTemp").textContent =
                showValue(latest.air_temperature);

            document.getElementById("humidity").textContent =
                showValue(latest.humidity);

            document.getElementById("readingTime").textContent =
                showTimestamp(latest.timestamp);

            document.getElementById("dataSource").textContent =
                latest.source || "Source not recorded";

            table.replaceChildren();

            readings.slice(0, 20).forEach(reading => {
                addTableRow(table, [
                    reading.id,
                    showTimestamp(reading.timestamp),
                    showValue(reading.moisture_raw),
                    showValue(reading.ph_raw),
                    showValue(reading.ec_raw),
                    showValue(reading.soil_temperature),
                    showValue(reading.air_temperature),
                    showValue(reading.humidity)
                ]);
            });

        } catch (error) {
            connection.textContent = "Connection error";
            connection.className = "error";
            statusDot.className = "status-dot offline";
            document.getElementById("heroStatus").textContent = "Server unavailable";
            setEmptyRow(table, 8, "Could not load sensor readings. Check that Flask is running.");
            console.error("Sensor readings error:", error);
        } finally {
            refreshButton.disabled = false;
        }
    }

    async function loadWeatherReadings() {
        const message = document.getElementById("weatherMessage");
        const table = document.getElementById("weatherTable");

        try {
            const response = await fetch("/api/weather-readings", {
                cache: "no-store"
            });

            if (!response.ok) {
                throw new Error("HTTP " + response.status);
            }

            const readings = await response.json();

            if (!Array.isArray(readings)) {
                throw new Error("Unexpected API response");
            }

            if (readings.length === 0) {
                setMessage(message, "No weather estimates saved yet.");
                setEmptyRow(table, 7, "No weather records available.");
                return;
            }

            const latest = readings[0];

            document.getElementById("weatherAirTemp").textContent =
                showValue(latest.air_temperature);

            document.getElementById("weatherHumidity").textContent =
                showValue(latest.humidity);

            document.getElementById("weatherSoilTemp").textContent =
                showValue(latest.soil_temperature);

            document.getElementById("weatherSoilMoisture").textContent =
                showValue(latest.soil_moisture, 3);

            document.getElementById("weatherTime").textContent =
                showTimestamp(latest.timestamp);

            setMessage(
                message,
                "Location: " + (latest.location || "Amritsar, Punjab") +
                " · Source: " + (latest.source || "Open-Meteo estimate")
            );

            table.replaceChildren();

            readings.slice(0, 20).forEach(reading => {
                addTableRow(table, [
                    showTimestamp(reading.timestamp),
                    reading.location || "Amritsar, Punjab",
                    showValue(reading.air_temperature),
                    showValue(reading.humidity),
                    showValue(reading.soil_temperature),
                    showValue(reading.soil_moisture, 3),
                    reading.source || "Open-Meteo estimate"
                ]);
            });

        } catch (error) {
            setMessage(message, "Weather loading error: " + error.message, "error");
            setEmptyRow(table, 7, "Could not load weather records.");
            console.error("Weather readings error:", error);
        }
    }

    async function fetchWeather() {
        const button = document.getElementById("fetchWeatherButton");
        const message = document.getElementById("weatherMessage");

        button.disabled = true;
        setMessage(message, "Fetching weather estimates...");

        try {
            const response = await fetch("/api/fetch-weather", {
                method: "POST",
                headers: {
                    "X-API-Key": WEATHER_API_KEY
                }
            });

            const result = await response.json();

            if (!response.ok) {
                throw new Error(result.error || "Request failed");
            }

            setMessage(message, "Weather estimate fetched successfully.", "success");
            await loadWeatherReadings();

        } catch (error) {
            setMessage(message, "Weather fetch failed: " + error.message, "error");
            console.error("Fetch weather error:", error);
        } finally {
            button.disabled = false;
        }
    }

    document.getElementById("manualForm").addEventListener("submit", async function(event) {
        event.preventDefault();

        const button = document.getElementById("addReadingButton");
        const message = document.getElementById("formMessage");

        const reading = {
            moisture_raw: Number(document.getElementById("inputMoisture").value),
            ph_raw: Number(document.getElementById("inputPh").value),
            ec_raw: Number(document.getElementById("inputEc").value),
            soil_temperature: Number(document.getElementById("inputSoilTemp").value),
            air_temperature: Number(document.getElementById("inputAirTemp").value),
            humidity: Number(document.getElementById("inputHumidity").value)
        };

        button.disabled = true;
        setMessage(message, "Saving test reading...");

        try {
            const response = await fetch("/manual-reading", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify(reading)
            });

            const result = await response.json();

            if (!response.ok) {
                throw new Error(result.error || "Unable to save reading");
            }

            setMessage(
                message,
                "Test reading #" + result.reading_id + " saved successfully.",
                "success"
            );

            await loadReadings();

        } catch (error) {
            setMessage(message, "Error: " + error.message, "error");
        } finally {
            button.disabled = false;
        }
    });

    // Initial loads and automatic refresh intervals.
    loadReadings();
    loadWeatherReadings();

    setInterval(loadReadings, 5000);
    setInterval(loadWeatherReadings, 15000);
</script>
</body>
</html>
